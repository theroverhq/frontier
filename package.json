{
	"name": "frontier",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test tests/*.test.mjs && python3 tests/private-download-signer.test.py",
		"test:leads": "node --test tests/google-leads.test.mjs",
		"setup:google-leads": "node scripts/prepare-google-leads.mjs",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:downloads": "node --test tests/private-download-client.test.mjs && python3 tests/private-download-signer.test.py",
		"test:phone": "node --test tests/phone-number.test.mjs",
		"generate:comparisons": "node scripts/generate-comparisons.mjs",
		"prebuild": "npm run generate:comparisons",
		"predev": "npm run generate:comparisons",
		"precheck": "npm run generate:comparisons",
		"upload:comparison": "node scripts/upload-comparison-pdf.mjs",
		"test:comparisons": "node --test tests/comparisons.test.mjs",
		"test:pricing": "node --test tests/data-lake-pricing.test.mjs tests/query-latency.test.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.31.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"bits-ui": "^2.18.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@fontsource/mitr": "^5.3.0",
		"clsx": "^2.1.1",
		"country-flag-icons": "^1.6.20",
		"libphonenumber-js": "^1.13.14",
		"marked": "^18.0.14",
		"tailwind-merge": "^3.6.0",
		"yaml": "^2.9.1"
	}
}
